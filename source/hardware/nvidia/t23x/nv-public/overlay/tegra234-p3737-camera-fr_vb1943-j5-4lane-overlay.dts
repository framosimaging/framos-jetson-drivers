 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3737-0000+p3701-0000.h>


/ {
	overlay-name = "Framos VB1943-J5-4Lane";
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;

	fragment@0 {
		target = <&sensor_module0>;
		__overlay__ {
			status = "okay";
			badge = "vb1943_bottomleft_framos";
			drivernode0 {
				status = "okay";
				/* Declare PCL support driver (classically known as guid) */
				devname = "vb1943 9-0010";
				/* Declare the device-tree hierarchy to driver instance */
				sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/tca9548@70/i2c@0/vb1943_a@10";
			};
		};
	};

	fragment@1 {
		target = <&sensor_vi_port0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@2 {
		target = <&sensor_vi_in0>;
		__overlay__ {
			status = "okay";
			bus-width = <4>;
		};
	};

	fragment@3 {
		target = <&sensor_csi_ch0>;
		__overlay__ {
			status = "okay";
			ports {
				status = "okay";
			};
		};
	};

	fragment@4 {
		target = <&sensor_csi_ch0_port0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@5 {
		target = <&sensor_csi_ch0_in>;
		__overlay__ {
			status = "okay";
			bus-width = <4>;
			remote-endpoint = <&sensor_out_a>;
		};
	};

	fragment@6 {
		target = <&sensor_csi_ch0_port1>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&sensor_csi_ch0_out>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target = <&tca9548_70_i2c0>;
		__overlay__ {
			sensor_a: vb1943_a@10 {
				compatible = "framos,vb1943";
				reg = <0x10>;

				/* Define any required hw resources needed by driver */
				/* ie. clocks, io pins, power sources */
				clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>, <&bpmp TEGRA234_CLK_EXTPERIPH1>;
				clock-names = "extperiph1", "pllp_grtba";
				mclk = "extperiph1";
				clock-frequency = <25000000>;

				devnode = "video0";

				physical_w = "8.90";
				physical_h = "10.30";

				sensor_model ="vb1943";

				/* Defines number of frames to be dropped by driver internally after applying */
				/* sensor crop settings. Some sensors send corrupt frames after applying */
				/* crop co-ordinates */
				post_crop_frame_drop = "0";

				/* Convert Gain to unit of dB (decibel) befor passing to kernel driver */
				use_decibel_gain = "false";

				/* if true, delay gain setting by one frame to be in sync with exposure */
				delayed_gain = "false";

				/* enable CID_SENSOR_MODE_ID for sensor modes selection */
				use_sensor_mode_id = "false";

				mode0 {
					mclk_khz = "25000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "2560";
					active_h = "1984";

					dynamic_pixel_bit_depth = "10";
					csi_pixel_bit_depth = "10";
					mode_type = "bayer";
					pixel_phase = "gbrg";

					readout_orientation = "0";
					line_length = "7000";
					inherent_gain = "1";
					pix_clk_hz = "600000000";
					serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

					gain_factor = "100";
					min_gain_val = "100"; /* 1x */
					max_gain_val = "400"; /* 4x */
					step_gain_val = "1"; /* 0.01x */
					default_gain = "100";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "100000000"; /* 100 */
					step_framerate = "1";
					default_framerate= "100000000";
					exposure_factor = "1000000";
					min_exp_time = "36"; /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "0";
				};
				mode1 {
					mclk_khz = "25000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "2064";
					active_h = "1552";

					dynamic_pixel_bit_depth = "10";
					csi_pixel_bit_depth = "10";
					mode_type = "bayer";
					pixel_phase = "gbrg";

					readout_orientation = "0";
					line_length = "7000";
					inherent_gain = "1";
					pix_clk_hz = "600000000";
					serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

					gain_factor = "100";
					min_gain_val = "100"; /* 1x */
					max_gain_val = "400"; /* 4x */
					step_gain_val = "1"; /* 0.01x */
					default_gain = "100";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "100000000"; /* 100 */
					step_framerate = "1";
					default_framerate= "100000000";
					exposure_factor = "1000000";
					min_exp_time = "36"; /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "0";
				};
				mode2 {
					mclk_khz = "25000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "1920";
					active_h = "1080";

					dynamic_pixel_bit_depth = "10";
					csi_pixel_bit_depth = "10";
					mode_type = "bayer";
					pixel_phase = "gbrg";

					readout_orientation = "0";
					line_length = "7000";
					inherent_gain = "1";
					pix_clk_hz = "600000000";
					serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

					gain_factor = "100";
					min_gain_val = "100"; /* 1x */
					max_gain_val = "400"; /* 4x */
					step_gain_val = "1"; /* 0.01x */
					default_gain = "100";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "100000000"; /* 100 */
					step_framerate = "1";
					default_framerate= "100000000";
					exposure_factor = "1000000";
					min_exp_time = "36"; /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "0";
				};
				mode3 {
					mclk_khz = "25000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "2560";
					active_h = "1984";

					dynamic_pixel_bit_depth = "12";
					csi_pixel_bit_depth = "12";
					mode_type = "bayer";
					pixel_phase = "gbrg";

					readout_orientation = "0";
					line_length = "7000";
					inherent_gain = "1";
					pix_clk_hz = "500000000";
					serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

					gain_factor = "100";
					min_gain_val = "100"; /* 1x */
					max_gain_val = "400"; /* 4x */
					step_gain_val = "1"; /* 0.01x */
					default_gain = "100";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "50000000"; /* 50 */
					step_framerate = "1";
					default_framerate= "50000000";
					exposure_factor = "1000000";
					min_exp_time = "36"; /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "0";
				};
				mode4 {
					mclk_khz = "25000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "2064";
					active_h = "1552";

					dynamic_pixel_bit_depth = "12";
					csi_pixel_bit_depth = "12";
					mode_type = "bayer";
					pixel_phase = "gbrg";

					readout_orientation = "0";
					line_length = "7000";
					inherent_gain = "1";
					pix_clk_hz = "500000000";
					serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

					gain_factor = "100";
					min_gain_val = "100"; /* 1x */
					max_gain_val = "400"; /* 4x */
					step_gain_val = "1"; /* 0.01x */
					default_gain = "100";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "50000000"; /* 50 */
					step_framerate = "1";
					default_framerate= "50000000";
					exposure_factor = "1000000";
					min_exp_time = "36"; /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "0";
				};
				mode5 {
					mclk_khz = "25000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "1920";
					active_h = "1080";

					dynamic_pixel_bit_depth = "12";
					csi_pixel_bit_depth = "12";
					mode_type = "bayer";
					pixel_phase = "gbrg";

					readout_orientation = "0";
					line_length = "7000";
					inherent_gain = "1";
					pix_clk_hz = "500000000";
					serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

					gain_factor = "100";
					min_gain_val = "100"; /* 1x */
					max_gain_val = "400"; /* 4x */
					step_gain_val = "1"; /* 0.01x */
					default_gain = "100";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "50000000"; /* 50 */
					step_framerate = "1";
					default_framerate= "50000000";
					exposure_factor = "1000000";
					min_exp_time = "36"; /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "0";
				};
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						sensor_out_a: endpoint {
							vc-id = <0>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&sensor_csi_ch0_in>;
						};
					};
				};
			};
		};
	};
};
