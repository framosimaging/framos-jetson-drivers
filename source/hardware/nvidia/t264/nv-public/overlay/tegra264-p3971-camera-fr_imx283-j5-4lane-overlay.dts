/dts-v1/;
/plugin/;

#include <dt-bindings/clock/tegra264-clock.h>
#include <dt-bindings/gpio/tegra264-gpio.h>
#include <dt-bindings/jetson-compatible.h>

/ {
	overlay-name = "Framos IMX283-J5-4Lane";
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;

	fragment@0 {
		target = <&sensor_module0>;
		__overlay__ {
			status = "okay";
			badge = "imx283_bottomleft_framos";
			drivernode0 {
				status = "okay";
				/* Declare PCL support driver (classically known as guid) */
				devname = "imx283 17-001a";
				/* Declare the device-tree hierarchy to driver instance */
				sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@810c6d0000/tca9548@70/i2c@0/imx283_a@1a";
			};
		};
	};

	fragment@1 {
		target = <&sensor_vi_port0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@2 {
		target = <&sensor_vi_in0>;
		__overlay__ {
			status = "okay";
			bus-width = <4>;
		};
	};

	fragment@3 {
		target = <&sensor_csi_ch0>;
		__overlay__ {
			status = "okay";
			ports {
				status = "okay";
			};
		};
	};

	fragment@4 {
		target = <&sensor_csi_ch0_port0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@5 {
		target = <&sensor_csi_ch0_in>;
		__overlay__ {
			status = "okay";
			bus-width = <4>;
			remote-endpoint = <&sensor_out_a>;
		};
	};

	fragment@6 {
		target = <&sensor_csi_ch0_port1>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&sensor_csi_ch0_out>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target = <&tca9548_70_i2c0>;
		__overlay__ {
			sensor_a: imx283_a@1a {
				compatible = "framos,imx283";
				reg = <0x1a>;

				/* Define any required hw resources needed by driver */
				/* ie. clocks, io pins, power sources */
				clocks = <&bpmp TEGRA264_CLK_EXTPERIPH1>, <&bpmp TEGRA264_CLK_PLLP_OUT0>;
				clock-names = "extperiph1", "pllp_grtba";
				mclk = "extperiph1";
				clock-frequency = <24000000>;

				devnode = "video0";

				physical_w = "20.00";
				physical_h = "16.80";

				sensor_model ="imx283";

				/* Defines number of frames to be dropped by driver internally after applying */
				/* sensor crop settings. Some sensors send corrupt frames after applying */
				/* crop co-ordinates */
				post_crop_frame_drop = "0";

				/* Convert Gain to unit of dB (decibel) befor passing to kernel driver */
				use_decibel_gain = "true";

				/* if true, delay gain setting by one frame to be in sync with exposure */
				delayed_gain = "false";

				/* enable CID_SENSOR_MODE_ID for sensor modes selection */
				use_sensor_mode_id = "false";

				mode0 {
					mclk_khz = "24000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "5496";
					active_h = "3694";
		    
					dynamic_pixel_bit_depth = "10";
					csi_pixel_bit_depth = "10";
					mode_type = "bayer";
					pixel_phase = "rggb";
		    
					readout_orientation = "0";
					line_length = "8900";
					inherent_gain = "1";
					pix_clk_hz = "576000000";
					serdes_pix_clk_hz = "12000000000";/* GMSL predefine */
		    
					gain_factor = "10";
					min_gain_val = "0"; /* 0dB */
					max_gain_val = "270"; /* 27dB */
					step_gain_val = "1"; /* 0.1 */
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "25000000"; /* 25 */
					step_framerate = "1";
					default_framerate= "25000000";
					exposure_factor = "1000000";
					min_exp_time = "44";  /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "1";
				};
				mode1 {
					mclk_khz = "24000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "5496";
					active_h = "3112";
		    
					dynamic_pixel_bit_depth = "10";
					csi_pixel_bit_depth = "10";
					mode_type = "bayer";
					pixel_phase = "rggb";
		    
					readout_orientation = "0";
					line_length = "9270";
					inherent_gain = "1";
					pix_clk_hz = "576000000";
					serdes_pix_clk_hz = "12000000000";/* GMSL predefine */
		    
					gain_factor = "10";
					min_gain_val = "0"; /* 0dB */
					max_gain_val = "270"; /* 27dB */
					step_gain_val = "1"; /* 0.1 */
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "30000000"; /* 30 */
					step_framerate = "1";
					default_framerate= "30000000";
					exposure_factor = "1000000";
					min_exp_time = "44";  /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "1";
				};
				mode2 {
					mclk_khz = "24000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "3840";
					active_h = "2160";
		    
					dynamic_pixel_bit_depth = "10";
					csi_pixel_bit_depth = "10";
					mode_type = "bayer";
					pixel_phase = "rggb";
		    
					readout_orientation = "0";
					line_length = "6750";
					inherent_gain = "1";
					pix_clk_hz = "576000000";
					serdes_pix_clk_hz = "12000000000";/* GMSL predefine */
		    
					gain_factor = "10";
					min_gain_val = "0"; /* 0dB */
					max_gain_val = "270"; /* 27dB */
					step_gain_val = "1"; /* 0.1 */
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "43000000"; /* 43 */
					step_framerate = "1";
					default_framerate= "30000000";
					exposure_factor = "1000000";
					min_exp_time = "33";  /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "1";
				};
				mode3 {
					mclk_khz = "24000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "1920";
					active_h = "1080";
		    
					dynamic_pixel_bit_depth = "12";
					csi_pixel_bit_depth = "12";
					mode_type = "bayer";
					pixel_phase = "rggb";
		    
					readout_orientation = "0";
					line_length = "4500";
					inherent_gain = "1";
					pix_clk_hz = "480000000";
					serdes_pix_clk_hz = "12000000000";/* GMSL predefine */
		    
					gain_factor = "10";
					min_gain_val = "0"; /* 0dB */
					max_gain_val = "270"; /* 27dB */
					step_gain_val = "1"; /* 0.1 */
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "50000000"; /* 60 */
					step_framerate = "1";
					default_framerate= "40000000";
					exposure_factor = "1000000";
					min_exp_time = "22";  /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "1";
				};
				mode4 {
					mclk_khz = "24000";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					active_w = "5496";
					active_h = "3694";
		    
					dynamic_pixel_bit_depth = "12";
					csi_pixel_bit_depth = "12";
					mode_type = "bayer";
					pixel_phase = "rggb";
		    
					readout_orientation = "0";
					line_length = "11250";
					inherent_gain = "1";
					pix_clk_hz = "480000000";
					serdes_pix_clk_hz = "12000000000";/* GMSL predefine */
		    
					gain_factor = "10";
					min_gain_val = "0"; /* 0dB */
					max_gain_val = "270"; /* 27dB */
					step_gain_val = "1"; /* 0.1 */
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "64";
					framerate_factor = "1000000";
					min_framerate = "1500000"; /* 1.5 */
					max_framerate = "21000000"; /* 21 */
					step_framerate = "1";
					default_framerate= "21000000";
					exposure_factor = "1000000";
					min_exp_time = "53";  /* us */
					max_exp_time = "660000"; /* us */
					step_exp_time = "1";
					default_exp_time = "10000";/* us */
					embedded_metadata_height = "1";
				};
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						sensor_out_a: endpoint {
							vc-id = <0>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&sensor_csi_ch0_in>;
						};
					};
				};
			};
		};
	};

};
